# Copy into .env.local for an isolated environment. Never commit real secrets.
# Public Supabase project identity (also required by admin Auth).
NEXT_PUBLIC_SITE_URL=https://www.eastcoastlabs.com.au
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never use a NEXT_PUBLIC prefix for privileged keys.
SUPABASE_SERVICE_ROLE_KEY=

# Scoped payment/review links: at least 32 characters. Keep stable across deploys.
# Omit this variable entirely to use domain-separated service-role fallback.
# A blank/short explicitly configured value deliberately fails closed.
# ORDER_ACCESS_SECRET=

# All cron endpoints require this secret; missing configuration returns 503.
CRON_SECRET=
# Marketing unsubscribe signatures; falls back to CRON_SECRET when blank.
UNSUBSCRIBE_SECRET=

# Optional delivery. Missing provider key leaves durable retries for operators.
RESEND_API_KEY=
RESEND_FROM_EMAIL=East Coast Labs <orders@eastcoastlabs.com.au>
# Svix signing secret from the Resend webhook configuration; server only.
RESEND_WEBHOOK_SECRET=

# Optional browser analytics. Public catalogue/content/checkout events only.
NEXT_PUBLIC_GA4_ID=
# Optional Measurement Protocol delivery of paid purchases. Server only.
GA4_API_SECRET=
# Comma-separated campaign IDs approved for first-party order attribution.
# Empty means no campaign is retained. Keep values non-personal and stable.
NEXT_PUBLIC_MEASUREMENT_CAMPAIGNS=
# Comma-separated experiment declarations: experiment-id:control|holdout
# Empty means every experiment is inactive, including the / and /1 designs.
NEXT_PUBLIC_MEASUREMENT_EXPERIMENTS=
# Route exposure is not random assignment. Leave inactive until an approved
# eligible-traffic allocator and readout plan are operating.
NEXT_PUBLIC_HOMEPAGE_EXPERIMENT_ACTIVE=

# Optional reorder reminder: integer days after dispatch, based on verified
# reorder research. Blank disables it; pack size never determines timing.
REORDER_REMINDER_DAYS=
# Optional stable retention holdout. Leave inactive until a declared readout
# is ready. The key is server-only and must remain stable for the experiment.
RETENTION_HOLDOUT_PERCENT=0
RETENTION_EXPERIMENT_ID=
RETENTION_HOLDOUT_KEY=

# Migration CLI only. Use direct PostgreSQL/session pooler and verified TLS.
SUPABASE_DB_URL=
# SUPABASE_DB_CA_FILE=/absolute/path/to/trusted-ca.pem
# SUPABASE_DB_SSL=disable # Only accepted for disposable loopback databases.

# Legacy emergency Woo integration is disabled for the native checkout.
# USE_WOO_CHECKOUT=1
# WOO_API_BASE=https://eastcoastlabs.com.au
# WOO_CHECKOUT_BASE=https://eastcoastlabs.com.au
