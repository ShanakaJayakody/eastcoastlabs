# East Coast Labs storefront — environment configuration
# Copy to .env.local and fill in real values for production.

# --- WooCommerce backend (headless) ---
# Base URL of the WooCommerce site that exposes the Store API + custom ECL endpoints.
# The storefront reads catalog + COA over REST from here (server-side).
WOO_API_BASE=https://eastcoastlabs.com.au

# Base URL used for the checkout hand-off. The "Checkout" button navigates the
# shopper to <WOO_CHECKOUT_BASE>/checkout, where the WooCommerce Bankful gateway
# runs. Payment stays on WooCommerce — the storefront never touches cards.
WOO_CHECKOUT_BASE=https://eastcoastlabs.com.au

# --- Analytics (optional — safe no-op when unset) ---
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Enables view_item /
# add_to_cart / begin_checkout / purchase events. Leave blank to disable.
NEXT_PUBLIC_GA4_ID=

# Klaviyo public API key / site ID (e.g. XXXXXX). Loads Klaviyo onsite JS.
# Leave blank to disable.
NEXT_PUBLIC_KLAVIYO_ID=
